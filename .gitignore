# ============================================================
#  StockWidget - Git 忽略规则
#  说明：仅忽略构建产物、缓存与本地环境文件，源码一律保留
# ============================================================

# ---------------------- Python 字节码缓存 ----------------------
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# ---------------------- 打包 / 构建产物 ----------------------
# PyInstaller
build/
dist/
*.manifest
*.toc
*.pyz
*.pkg
warn-*.txt
xref-*.html
base_library.zip
localpycs/

# Nuitka / Cython 等其它打包工具的中间产物
*.build/
*.dist/
*.onefile-build/

# 备份与临时文件
*.bak
*.tmp
*.temp
*.orig
*.rej
*~

# ---------------------- 虚拟环境 ----------------------
venv/
.venv/
env/
ENV/
.python-version
pip-log.txt
pip-delete-this-directory.txt

# ---------------------- 测试 / 覆盖率 ----------------------
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.cache/

# ---------------------- 类型检查 / 代码检查缓存 ----------------------
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# ---------------------- 编辑器 / IDE ----------------------
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ---------------------- 操作系统 ----------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---------------------- 日志 ----------------------
*.log
logs/

# ---------------------- 本地配置（保留示例文件） ----------------------
config.local.*
settings.local.*
*.local.json
!*.example.json
